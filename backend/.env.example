# Copy this file to .env for local development. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=task_manager

# Optional: provider connection URI. It overrides DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# DATABASE_URL=mysql://username:password@host:port/database?ssl-mode=REQUIRED

# Generate a strong secret locally; never use the example value in deployment.
JWT_SECRET_KEY=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost:5173
FLASK_DEBUG=false
PORT=5000
